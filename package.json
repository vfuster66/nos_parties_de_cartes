{
  "name": "nos-parties-de-cartes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:online": "concurrently -k -n serveur,client -c blue,green \"npm:dev:server\" \"VITE_ONLINE_SERVER_URL=same-origin vite\"",
    "dev:lan": "concurrently -k -n serveur,client -c blue,green \"ALLOW_PRIVATE_NETWORK_ORIGINS=1 npm run dev:server\" \"VITE_ONLINE_SERVER_URL=same-origin vite --host\"",
    "build": "vue-tsc --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json && esbuild server/src/index.ts server/src/backup.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outdir=server/dist --out-extension:.js=.mjs",
    "build:all": "npm run build && npm run build:server",
    "soak": "tsx tools/soak.ts",
    "start:server": "node server/dist/index.mjs",
    "server:backup": "node server/dist/backup.mjs",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:review": "REVIEW=1 playwright test e2e/review.spec.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "pinia": "^4.1.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=20.19"
  }
}
