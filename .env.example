# Copier vers .env (ignoré par Git). Aucun secret n'est requis : l'identité repose sur des jetons générés à l'exécution.

# --- Client (Vite, lu au BUILD) ---
# Vide : « Jouer en ligne » est masqué (cas de GitHub Pages).
# same-origin : serveur derrière le même hôte (proxy Vite en dev, reverse proxy en prod).
# https://jeu.exemple.fr : serveur sur un autre domaine (à autoriser dans ALLOWED_ORIGINS).
VITE_ONLINE_SERVER_URL=

# --- Serveur ---
PORT=3001
HOST=127.0.0.1
DB_PATH=./data/coinche.sqlite
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Développement sur téléphone seulement : accepte aussi les origines du réseau local.
ALLOW_PRIVATE_NETWORK_ORIGINS=0
# 1 uniquement derrière un reverse proxy de confiance (lit X-Forwarded-For pour les limites par IP).
TRUST_PROXY=0
